function generateReport() {
  const wps = state.route.waypoints;
  const el = document.getElementById("reportContent");
  if (wps.length < 2) {
    el.innerHTML = `<p class="hint">No route loaded — nothing to report yet.</p>`;
    return;
  }

  let totalDist = 0;
  for (let i = 0; i < wps.length - 1; i++) {
    totalDist += nmDistance(wps[i].lat, wps[i].lon, wps[i + 1].lat, wps[i + 1].lon);
  }

  const result = runRouteCheck(wps);
  let html = `
    <h3 style="margin-bottom:2px;">VOYAGE COMPLIANCE REPORT</h3>
    <div class="hint">Generated: ${new Date().toLocaleString()}</div>
    <p><strong>Route:</strong> ${wps[0].name} &rarr; ${wps[wps.length - 1].name} (${wps.length} waypoints)<br>
    <strong>Total distance:</strong> ${totalDist.toFixed(1)} nm &nbsp;
    <strong>ETD:</strong> ${new Date(wps[0].etd).toLocaleString()} &nbsp;
    <strong>ETA:</strong> ${new Date(wps[wps.length - 1].etd).toLocaleString()}</p>

    <h3>Waypoints</h3>
    <table><thead><tr><th>WP</th><th>Name</th><th>Lat</th><th>Lon</th><th>Speed (kn)</th><th>ETD/ETA</th></tr></thead><tbody>
    ${wps.map((wp, i) => `<tr><td>${i + 1}</td><td>${wp.name}</td><td>${wp.lat.toFixed(4)}</td><td>${wp.lon.toFixed(4)}</td><td>${wp.speed}</td><td>${new Date(wp.etd).toLocaleString()}</td></tr>`).join("")}
    </tbody></table>

    <h3>MARPOL / ECA Compliance Timeline</h3>`;

  if (result.message) {
    html += `<p>${result.message}</p>`;
  } else {
    html += `<table><thead><tr><th>Leg</th><th>Event</th><th>Entry WP</th><th>Exit WP</th><th>Rule</th></tr></thead><tbody>
    ${result.events.map(ev => `<tr><td>${ev.leg}</td><td>${ev.event}</td><td>${ev.entryWp}</td><td>${ev.exitWp}</td><td>${ev.rule}</td></tr>`).join("")}
    </tbody></table>`;
  }

  el.innerHTML = html;
}

window.generateReport = generateReport;
"path":"js/world_map.js
let mapView = { centerLon: 0, centerLat: 20, zoom: 1 };
let mapCanvas, mapCtx;
let mapDragging = false, mapDragStart = null;

function initWorldMap() {
  mapCanvas = document.getElementById("mapCanvas");
  mapCtx = mapCanvas.getContext("2d");
  resizeMapCanvas();
  window.addEventListener("resize", () => { resizeMapCanvas(); drawMap(); });

  mapCanvas.addEventListener("mousedown", (e) => {
    mapDragging = true;
    mapDragStart = { x: e.offsetX, y: e.offsetY, centerLon: mapView.centerLon, centerLat: mapView.centerLat };
  });
  window.addEventListener("mouseup", () => { mapDragging = false; });
  mapCanvas.addEventListener("mousemove", (e) => {
    if (!mapDragging) return;
    const scale = baseScale() * mapView.zoom;
    const dx = (e.offsetX - mapDragStart.x) / scale;
    const dy = (e.offsetY - mapDragStart.y) / scale;
    mapView.centerLon = mapDragStart.centerLon - dx;
    mapView.centerLat = mapDragStart.centerLat + dy;
    drawMap();
  });
  mapCanvas.addEventListener("wheel", (e) => {
    e.preventDefault();
    const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
    mapView.zoom = Math.max(0.3, Math.min(60, mapView.zoom * factor));
    drawMap();
  }, { passive: false });

  drawMap();
}

function resizeMapCanvas() {
  const wrap = mapCanvas.parentElement;
  mapCanvas.width = wrap.clientWidth;
  mapCanvas.height = 520;
}

function baseScale() {
  return mapCanvas.width / 360;
}

function project(lat, lon) {
  const scale = baseScale() * mapView.zoom;
  const x = mapCanvas.width / 2 + (lon - mapView.centerLon) * scale;
  const y = mapCanvas.height / 2 - (lat - mapView.centerLat) * scale;
  return [x, y];
}

function themeColor(varName) {
  return getComputedStyle(document.body).getPropertyValue(varName).trim();
}

function drawMap() {
  if (!mapCtx) return;
  const w = mapCanvas.width, h = mapCanvas.height;
  mapCtx.fillStyle = themeColor("--bg");
  mapCtx.fillRect(0, 0, w, h);

  mapCtx.strokeStyle = "rgba(255,255,255,0.06)";
  mapCtx.lineWidth = 1;
  for (let lon = -180; lon <= 180; lon += 30) {
    const [x1, y1] = project(-90, lon);
    const [x2, y2] = project(90, lon);
    mapCtx.beginPath();
    mapCtx.moveTo(x1, y1); mapCtx.lineTo(x2, y2); mapCtx.stroke();
  }
  for (let lat = -60; lat <= 90; lat += 30) {
    const [x1, y1] = project(lat, -180);
    const [x2, y2] = project(lat, 180);
    mapCtx.beginPath();
    mapCtx.moveTo(x1, y1); mapCtx.lineTo(x2, y2); mapCtx.stroke();
  }

  const showZones = document.getElementById("showAreasChk") && document.getElementById("showAreasChk").checked;
  if (showZones) {
    mapCtx.strokeStyle = "rgba(242,166,90,0.45)";
    mapCtx.lineWidth = 1;
    for (const area of GEO_AREAS) {
      if (area.testType !== "POLYGON") continue;
      mapCtx.beginPath();
      area.param.forEach(([lat, lon], i) => {
        const [x, y] = project(lat, lon);
        if (i === 0) mapCtx.moveTo(x, y); else mapCtx.lineTo(x, y);
      });
      mapCtx.closePath();
      mapCtx.stroke();
    }
  }

  const wps = state.route.waypoints;
  if (wps.length >= 2) {
    mapCtx.strokeStyle = themeColor("--accent2");
    mapCtx.lineWidth = 2;
    mapCtx.beginPath();
    wps.forEach((wp, i) => {
      const [x, y] = project(wp.lat, wp.lon);
      if (i === 0) mapCtx.moveTo(x, y); else mapCtx.lineTo(x, y);
    });
    mapCtx.stroke();
    mapCtx.fillStyle = themeColor("--accent2");
    wps.forEach(wp => {
      const [x, y] = project(wp.lat, wp.lon);
      mapCtx.beginPath();
      mapCtx.arc(x, y, 3.5, 0, Math.PI * 2);
      mapCtx.fill();
    });
  }

  if (window.vesselPos) {
    const [x, y] = project(window.vesselPos.lat, window.vesselPos.lon);
    mapCtx.fillStyle = "#FF5050";
    mapCtx.beginPath();
    mapCtx.moveTo(x, y - 8);
    mapCtx.lineTo(x - 6, y + 6);
    mapCtx.lineTo(x + 6, y + 6);
    mapCtx.closePath();
    mapCtx.fill();
  }
}

function mapZoomFullWorld() {
  mapView = { centerLon: 0, centerLat: 20, zoom: 1 };
  drawMap();
}

function mapZoomToRoute() {
  const wps = state.route.waypoints;
  if (wps.length === 0) { alert("No route loaded to zoom to."); return; }
  let minLat = wps[0].lat, maxLat = wps[0].lat, minLon = wps[0].lon, maxLon = wps[0].lon;
  wps.forEach(wp => {
    minLat = Math.min(minLat, wp.lat); maxLat = Math.max(maxLat, wp.lat);
    minLon = Math.min(minLon, wp.lon); maxLon = Math.max(maxLon, wp.lon);
  });
  mapView.centerLat = (minLat + maxLat) / 2;
  mapView.centerLon = (minLon + maxLon) / 2;
  const spanLon = Math.max(2, maxLon - minLon) * 1.4;
  mapView.zoom = Math.max(0.3, Math.min(60, 360 / spanLon));
  drawMap();
}

window.drawMap = drawMap;
window.initWorldMap = initWorldMap;
window.mapZoomFullWorld = mapZoomFullWorld;
window.mapZoomToRoute = mapZoomToRoute;
"path":"js/xlsx_import.js
function xmlUnescape(s) {
  return s.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"')
          .replace(/&apos;/g, "'").replace(/&amp;/g, "&");
}

function parseSharedStrings(xml) {
  if (!xml) return [];
  const strings = [];
  const siBlocks = xml.match(/<si[ >][\s\S]*?<\/si>/g) || [];
  for (const block of siBlocks) {
    const parts = block.match(/<t[^>]*>([\s\S]*?)<\/t>/g) || [];
    const text = parts.map(p => xmlUnescape(p.replace(/<[^>]+>/g, ""))).join("");
    strings.push(text);
  }
  return strings;
}

function excelSerialToDate(serial) {
  const utcDays = Math.floor(serial - 25569);
  const utcValue = utcDays * 86400;
  const dateInfo = new Date(utcValue * 1000);
  const fractionalDay = serial - Math.floor(serial);
  const totalSeconds = Math.round(fractionalDay * 86400);
  dateInfo.setUTCHours(0, 0, 0, 0);
  dateInfo.setUTCSeconds(totalSeconds);
  return dateInfo;
}

function colLetterToIndex(letters) {
  let n = 0;
  for (const ch of letters) n = n * 26 + (ch.charCodeAt(0) - 64);
  return n - 1;
}

function parseWorksheetXml(xml, sharedStrings) {
  const rows = [];
  const rowBlocks = xml.match(/<row[^>]*>[\s\S]*?<\/row>/g) || [];
  for (const rowXml of rowBlocks) {
    const cellMatches = rowXml.match(/<c[^>]*\/>|<c[^>]*>[\s\S]*?<\/c>/g) || [];
    const row = [];
    for (const cellXml of cellMatches) {
      const refMatch = cellXml.match(/r="([A-Z]+)\d+"/);
      const typeMatch = cellXml.match(/t="([^"]+)"/);
      const valMatch = cellXml.match(/<v>([\s\S]*?)<\/v>/);
      const inlineMatch = cellXml.match(/<is>[\s\S]*?<t[^>]*>([\s\S]*?)<\/t>[\s\S]*?<\/is>/);
      if (!refMatch) continue;
      const colIdx = colLetterToIndex(refMatch[1]);
      let value;
      if (inlineMatch) {
        value = xmlUnescape(inlineMatch[1]);
      } else if (valMatch) {
        const raw = valMatch[1];
        if (typeMatch && typeMatch[1] === "s") {
          value = sharedStrings[parseInt(raw, 10)] || "";
        } else if (typeMatch && typeMatch[1] === "str") {
          value = xmlUnescape(raw);
        } else {
          value = raw;
        }
      } else {
        value = "";
      }
      row[colIdx] = value;
    }
    rows.push(row);
  }
  return rows;
}

async function importXlsxRoute(arrayBuffer) {
  const entries = await readZipEntries(arrayBuffer, ["xl/sharedStrings.xml", "xl/worksheets/sheet1.xml"]);
  if (!entries["xl/worksheets/sheet1.xml"]) {
    throw new Error("Could not find xl/worksheets/sheet1.xml - only the first sheet is read in this version.");
  }
  const sharedStrings = parseSharedStrings(entries["xl/sharedStrings.xml"] ? bytesToText(entries["xl/sharedStrings.xml"]) : "");
  const rows = parseWorksheetXml(bytesToText(entries["xl/worksheets/sheet1.xml"]), sharedStrings);
  return rowsToWaypointResult(rows);
}

function rowsToWaypointResult(rows) {
  const result = { waypoints: [], log: [] };
  if (rows.length === 0) return result;
  const headers = rows[0].map(h => (h === undefined ? "" : String(h)));
  const map = mapHeaders(headers);
  if (map.lat < 0 || map.lon < 0 || map.spd < 0 || map.etd < 0) {
    result.log.push({ row: 1, field: "header", value: "-", reason: "Required column missing (need lat/lon/speed/ETD)", fix: "Check the header row" });
    return result;
  }

  let prevEtd = null;
  for (let r = 1; r < rows.length; r++) {
    const cols = rows[r] || [];
    const rowNum = r + 1;
    let ok = true;
    let lat, lon, spd, etd;

    const latRaw = cols[map.lat] === undefined ? "" : String(cols[map.lat]);
    const lonRaw = cols[map.lon] === undefined ? "" : String(cols[map.lon]);
    try { lat = parseFloat(latRaw); if (isNaN(lat) || lat < -90 || lat > 90) throw new Error("Latitude out of range: " + latRaw); }
    catch (e) { result.log.push({ row: rowNum, field: "Latitude", value: latRaw, reason: e.message, fix: "Use a decimal latitude" }); ok = false; }
    try { lon = parseFloat(lonRaw); if (isNaN(lon) || lon < -180 || lon > 180) throw new Error("Longitude out of range: " + lonRaw); }
    catch (e) { result.log.push({ row: rowNum, field: "Longitude", value: lonRaw, reason: e.message, fix: "Use a decimal longitude" }); ok = false; }

    if (ok) {
      spd = parseFloat(cols[map.spd]);
      if (isNaN(spd) || spd <= 0 || spd > 40) {
        result.log.push({ row: rowNum, field: "Speed", value: cols[map.spd], reason: "Speed must be numeric, >0 and <=40kn", fix: "Check the source value" });
        ok = false;
      }
    }

    if (ok) {
      const etdRaw = cols[map.etd];
      if (typeof etdRaw === "string" && /^\d+(\.\d+)?$/.test(etdRaw) && parseFloat(etdRaw) > 1000) {
        etd = excelSerialToDate(parseFloat(etdRaw));
      } else {
        etd = new Date(etdRaw);
      }
      if (isNaN(etd.getTime())) {
        result.log.push({ row: rowNum, field: "ETD/ETA", value: etdRaw, reason: "Unparseable date/time", fix: "Use a real date cell or an ISO date string" });
        ok = false;
      }
    }

    if (ok && prevEtd && etd < prevEtd) {
      result.log.push({ row: rowNum, field: "ETD/ETA", value: cols[map.etd], reason: "Out of chronological order vs previous waypoint", fix: "Check waypoint sequence" });
      ok = false;
    }

    if (ok) {
      result.waypoints.push({
        name: map.name >= 0 && cols[map.name] !== undefined ? String(cols[map.name]) : `WP${result.waypoints.length + 1}`,
        lat, lon, speed: spd, etd: etd.toISOString(),
      });
      prevEtd = etd;
    }
  }
  return result;
}

window.importXlsxRoute = importXlsxRoute;
window.rowsToWaypointResult = rowsToWaypointResult;
"path":"js/rtz_import.js
function getAttr(tagXml, attrName) {
  const m = tagXml.match(new RegExp(`${attrName}="([^"]*)"`));
  return m ? xmlUnescape(m[1]) : "";
}

function parseIso8601(s) {
  return new Date(s);
}

function importRtzXml(xmlText) {
  const result = { waypoints: [], log: [] };

  const wpBlocks = xmlText.match(/<waypoint\b[^>]*>[\s\S]*?<\/waypoint>|<waypoint\b[^>]*\/>/g) || [];
  if (wpBlocks.length === 0) {
    result.log.push({ row: 0, field: "waypoints", value: "-", reason: "No <waypoint> elements found - this file may use a different RTZ schema version", fix: "Check the source RTZ file" });
    return result;
  }

  const legBlocks = xmlText.match(/<leg\b[^>]*\/>|<leg\b[^>]*>[\s\S]*?<\/leg>/g) || [];

  wpBlocks.forEach((wpXml, i) => {
    const wpTagMatch = wpXml.match(/<waypoint\b[^>]*>/);
    const wpTag = wpTagMatch ? wpTagMatch[0] : wpXml;
    const wpId = getAttr(wpTag, "id");
    const wpName = getAttr(wpTag, "name");

    const posMatch = wpXml.match(/<position\b[^>]*\/>|<position\b[^>]*>/);
    if (!posMatch) {
      result.log.push({ row: i + 1, field: "position", value: "-", reason: "Waypoint has no <position> element", fix: "Check the source RTZ file" });
      return;
    }
    const posTag = posMatch[0];
    const latStr = getAttr(posTag, "lat");
    const lonStr = getAttr(posTag, "lon");

    let ok = true;
    const lat = parseFloat(latStr), lon = parseFloat(lonStr);
    if (isNaN(lat) || lat < -90 || lat > 90) {
      result.log.push({ row: i + 1, field: "Latitude", value: latStr, reason: "Not a valid latitude", fix: "Check the <position lat=...> value" });
      ok = false;
    }
    if (isNaN(lon) || lon < -180 || lon > 180) {
      result.log.push({ row: i + 1, field: "Longitude", value: lonStr, reason: "Not a valid longitude", fix: "Check the <position lon=...> value" });
      ok = false;
    }

    let speed = 0;
    const isLastWp = (i === wpBlocks.length - 1);
    const leg = legBlocks.find(l => getAttr(l, "startWaypointId") === wpId);
    if (leg) {
      const s1 = getAttr(leg, "speedMax");
      const s2 = getAttr(leg, "speed");
      speed = parseFloat(s1 || s2);
    }
    if (ok && !isLastWp && (isNaN(speed) || speed <= 0)) {
      result.log.push({ row: i + 1, field: "Speed", value: String(speed), reason: "No usable leg speed found for this waypoint", fix: "Check the source RTZ's <leg speedMax=...> values" });
      ok = false;
    }
    if (isLastWp && (isNaN(speed) || speed <= 0)) speed = 0;

    let etd = null, haveEtd = false;
    const schedMatch = wpXml.match(/<schedule\b[^>]*\/>|<schedule\b[^>]*>/);
    if (schedMatch) {
      const schedTag = schedMatch[0];
      const etaStr = getAttr(schedTag, "eta") || getAttr(schedTag, "etd");
      if (etaStr) {
        const d = parseIso8601(etaStr);
        if (!isNaN(d.getTime())) { etd = d; haveEtd = true; }
      }
    }
    if (ok && !haveEtd) {
      result.log.push({ row: i + 1, field: "ETD/ETA", value: "-", reason: "No schedule/ETA found on this waypoint", fix: "Position/speed still imported; add times manually in Route Import if you need them" });
    }

    if (ok) {
      result.waypoints.push({
        name: wpName || `WP${result.waypoints.length + 1}`,
        lat, lon, speed,
        etd: haveEtd ? etd.toISOString() : null,
      });
    }
  });

  return result;
}

async function importRtzpRoute(arrayBuffer) {
  const bytes = new Uint8Array(arrayBuffer);
  const dv = new DataView(arrayBuffer);
  const EOCD_SIG = 0x06054b50;
  let eocdPos = -1;
  for (let i = bytes.length - 22; i >= 0; i--) {
    if (dv.getUint32(i, true) === EOCD_SIG) { eocdPos = i; break; }
  }
  if (eocdPos === -1) throw new Error("Not a valid .rtzp (ZIP) archive");
  const cdCount = dv.getUint16(eocdPos + 10, true);
  const cdOffset = dv.getUint32(eocdPos + 16, true);
  let pos = cdOffset;
  let rtzName = null;
  for (let i = 0; i < cdCount; i++) {
    const nameLen = dv.getUint16(pos + 28, true);
    const extraLen = dv.getUint16(pos + 30, true);
    const commentLen = dv.getUint16(pos + 32, true);
    const name = new TextDecoder("utf-8").decode(bytes.slice(pos + 46, pos + 46 + nameLen));
    if (name.toLowerCase().endsWith(".rtz")) rtzName = name;
    pos += 46 + nameLen + extraLen + commentLen;
  }
  if (!rtzName) throw new Error("No .rtz file found inside this .rtzp archive");
  const entries = await readZipEntries(arrayBuffer, [rtzName]);
  return importRtzXml(bytesToText(entries[rtzName]));
}

window.importRtzXml = importRtzXml;
window.importRtzpRoute = importRtzpRoute;
"path":"js/zip_reader.js
async function readZipEntries(arrayBuffer, wantedNames) {
  const bytes = new Uint8Array(arrayBuffer);
  const dv = new DataView(arrayBuffer);
  const EOCD_SIG = 0x06054b50;
  let eocdPos = -1;
  for (let i = bytes.length - 22; i >= Math.max(0, bytes.length - 22 - 65557); i--) {
    if (dv.getUint32(i, true) === EOCD_SIG) { eocdPos = i; break; }
  }
  if (eocdPos === -1) throw new Error("Not a valid ZIP archive (no End Of Central Directory found)");

  const cdCount = dv.getUint16(eocdPos + 10, true);
  const cdOffset = dv.getUint32(eocdPos + 16, true);

  const wanted = new Set(wantedNames);
  const found = {};

  let pos = cdOffset;
  const CD_SIG = 0x02014b50;
  for (let i = 0; i < cdCount; i++) {
    if (dv.getUint32(pos, true) !== CD_SIG) break;
    const compMethod = dv.getUint16(pos + 10, true);
    const compSize = dv.getUint32(pos + 20, true);
    const uncompSize = dv.getUint32(pos + 24, true);
    const nameLen = dv.getUint16(pos + 28, true);
    const extraLen = dv.getUint16(pos + 30, true);
    const commentLen = dv.getUint16(pos + 32, true);
    const localHeaderOffset = dv.getUint32(pos + 42, true);
    const nameBytes = bytes.slice(pos + 46, pos + 46 + nameLen);
    const name = new TextDecoder("utf-8").decode(nameBytes);

    if (wanted.has(name)) {
      const raw = await extractLocalEntry(bytes, dv, localHeaderOffset, compMethod, compSize);
      found[name] = raw;
    }
    pos += 46 + nameLen + extraLen + commentLen;
  }
  return found;
}

async function extractLocalEntry(bytes, dv, localOffset, compMethod, compSize) {
  const LOCAL_SIG = 0x04034b50;
  if (dv.getUint32(localOffset, true) !== LOCAL_SIG) throw new Error("Bad local file header");
  const nameLen = dv.getUint16(localOffset + 26, true);
  const extraLen = dv.getUint16(localOffset + 28, true);
  const dataStart = localOffset + 30 + nameLen + extraLen;
  const compData = bytes.slice(dataStart, dataStart + compSize);

  if (compMethod === 0) return compData;
  if (compMethod === 8) return await inflateRaw(compData);
  throw new Error(`Unsupported ZIP compression method: ${compMethod}`);
}

async function inflateRaw(compressedBytes) {
  const ds = new DecompressionStream("deflate-raw");
  const writer = ds.writable.getWriter();
  writer.write(compressedBytes);
  writer.close();
  const chunks = [];
  const reader = ds.readable.getReader();
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    chunks.push(value);
  }
  const total = chunks.reduce((n, c) => n + c.length, 0);
  const out = new Uint8Array(total);
  let offset = 0;
  for (const c of chunks) { out.set(c, offset); offset += c.length; }
  return out;
}

function bytesToText(bytes) {
  return new TextDecoder("utf-8").decode(bytes);
}

window.readZipEntries = readZipEntries;
window.bytesToText = bytesToText;
